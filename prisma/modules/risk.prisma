enum RiskLevel {
  low
  medium
  high
  critical
}

enum ControlStatus {
  not_applicable
  not_started
  in_progress
  satisfied
  failed
}

enum ControlSeverity {
  low
  medium
  high
}

model RiskFramework {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  version     String
  description String        @default("") @db.Text
  controls    RiskControl[]

  @@map("risk_framework")
}

model RiskControl {
  id          String          @id @default(cuid())
  frameworkId String
  code        String
  title       String
  description String          @db.Text
  severity    ControlSeverity @default(medium)

  framework RiskFramework          @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  statuses  UsecaseControlStatus[]
  evidences Evidence[]
  catalogLinks  RiskCatalogMitigation[]
  crosswalkSource ControlCrosswalk[] @relation("CrosswalkSource")
  crosswalkTarget ControlCrosswalk[] @relation("CrosswalkTarget")

  frameworkRefs Json    @default("{}")
  sourceUrl     String?

  @@unique([frameworkId, code])
  @@map("risk_control")
}

model UsecaseRiskAssessment {
  id           String    @id @default(cuid())
  orgId        String
  usecaseId    String
  scoreInt     Int
  level        RiskLevel
  notes        String    @default("") @db.Text
  assessedById String
  assessedAt   DateTime  @default(now())
  pdfFileKey   String?

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase    AiUsecase    @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  assessedBy User         @relation("AssessmentAuthor", fields: [assessedById], references: [id])

  @@index([orgId, usecaseId, assessedAt(sort: Desc)])
  @@map("usecase_risk_assessment")
}

model UsecaseControlStatus {
  orgId     String
  usecaseId String
  controlId String
  status    ControlStatus @default(not_started)
  updatedAt DateTime      @updatedAt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase AiUsecase    @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  control RiskControl  @relation(fields: [controlId], references: [id], onDelete: Cascade)

  @@id([usecaseId, controlId])
  @@index([orgId, status])
  @@map("usecase_control_status")
}

enum RiskLinkSource {
  ai
  manual
}

model UsecaseCatalogRiskLink {
  id            String         @id @default(cuid())
  orgId         String
  usecaseId     String
  riskCatalogId String
  severity      RiskLevel
  source        RiskLinkSource
  rationale     String         @db.Text @default("")
  acceptedById  String
  acceptedAt    DateTime       @default(now())

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase    AiUsecase    @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  risk       RiskCatalog  @relation(fields: [riskCatalogId], references: [id], onDelete: Cascade)
  acceptedBy User         @relation("CatalogRiskAccepter", fields: [acceptedById], references: [id])

  @@unique([orgId, usecaseId, riskCatalogId])
  @@index([orgId, usecaseId])
  @@index([riskCatalogId])
  @@map("usecase_catalog_risk_link")
}
