enum FriaStatus {
  draft
  submitted
  approved
  archived
}

model UsecaseFria {
  id            String     @id @default(cuid())
  orgId         String
  usecaseId     String
  version       Int        @default(1)
  status        FriaStatus @default(draft)

  title         String

  sectionsJson  Json       @default("{}")

  createdById   String
  submittedAt   DateTime?
  submittedById String?
  approvedAt    DateTime?
  approvedById  String?
  archivedAt    DateTime?
  archivedById  String?
  supersededById String?   @unique

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase      AiUsecase     @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  createdBy    User          @relation("FriaCreator",   fields: [createdById],   references: [id])
  submittedBy  User?         @relation("FriaSubmitter", fields: [submittedById], references: [id])
  approvedBy   User?         @relation("FriaApprover",  fields: [approvedById],  references: [id])
  archivedBy   User?         @relation("FriaArchiver",  fields: [archivedById],  references: [id])
  supersededBy UsecaseFria?  @relation("FriaSupersede", fields: [supersededById], references: [id])
  supersedes   UsecaseFria[] @relation("FriaSupersede")

  @@unique([usecaseId, version])
  @@index([orgId, usecaseId, status])
  @@index([orgId, status, updatedAt(sort: Desc)])
  @@map("usecase_fria")
}
