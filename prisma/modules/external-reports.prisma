model ExternalReport {
  id            String   @id @default(cuid())
  orgId         String
  usecaseId     String
  type          String
  status        String   @default("received")
  title         String
  description   String   @db.Text
  reporterEmail String?
  reproSteps    String   @default("") @db.Text
  reporterMeta  Json     @default("{}")
  embedding     Json?

  citedProhibitedUseClause String    @default("") @db.Text
  triageNotes              String    @default("") @db.Text
  resolvedById             String?
  resolvedAt               DateTime?
  escalatedIncidentId      String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase    AiUsecase    @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  resolvedBy User?        @relation(fields: [resolvedById], references: [id], onDelete: SetNull)
  incident   Incident?    @relation(fields: [escalatedIncidentId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([orgId, type])
  @@index([usecaseId])
  @@map("external_report")
}