enum PolicyAssistantStatus {
  ok
  needs_review
  failed
}

model PolicyAssistantGeneration {
  id            String                @id @default(cuid())
  orgId         String
  userId        String
  description   String                @db.Text
  status        PolicyAssistantStatus
  outputJson    Json
  providerType  String
  model         String
  inputTokens   Int
  outputTokens  Int
  latencyMs     Int
  retryCount    Int                   @default(0)
  errorMessage  String?               @db.Text
  createdAt     DateTime              @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation("PolicyAssistantAuthor", fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt(sort: Desc)])
  @@index([orgId, userId, createdAt])
  @@map("policy_assistant_generation")
}
