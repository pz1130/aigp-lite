enum TxrStatus {
  draft
  submitted
  approved
  published
  superseded
}

model TxrReport {
  id             String    @id @default(cuid())
  orgId          String
  usecaseId      String?
  version        Int       @default(1)
  status         TxrStatus @default(draft)
  title          String
  periodStart    DateTime
  periodEnd      DateTime
  periodLabel    String
  sections       Json      @default("{}")
  snapshot       Json?
  createdById    String
  submittedAt    DateTime?
  submittedById  String?
  approvedAt     DateTime?
  approvedById   String?
  publishedAt    DateTime?
  publishedById  String?
  supersededById String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  usecase      AiUsecase?   @relation(fields: [usecaseId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("TxrCreator", fields: [createdById], references: [id])
  submittedBy  User?        @relation("TxrSubmitter", fields: [submittedById], references: [id])
  approvedBy   User?        @relation("TxrApprover", fields: [approvedById], references: [id])
  publishedBy  User?        @relation("TxrPublisher", fields: [publishedById], references: [id])
  supersededBy TxrReport?   @relation("TxrSupersede", fields: [supersededById], references: [id])
  supersedes   TxrReport[]  @relation("TxrSupersede")

  @@unique([orgId, usecaseId, version])
  @@index([orgId, usecaseId, status])
  @@index([orgId, status, updatedAt(sort: Desc)])
  @@map("txr_report")
}
