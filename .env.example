# Database
DATABASE_URL=postgresql://aigp:aigp@db:5432/aigp?schema=public

# Dedicated database for `pnpm test` (vitest globalSetup TRUNCATEs every table).
# Without this set, the test runner refuses to nuke a DATABASE_URL that has data.
# Run `pnpm test:db:setup` once to provision it.
TEST_DATABASE_URL=postgresql://aigp:aigp@db:5432/aigp_test?schema=public

# Encryption key for provider credentials (M8+)
AIGP_ENCRYPTION_KEY=     # base64-encoded 32 bytes: openssl rand -base64 32
# Optional dev fallback seed (only used when AIGP_ENCRYPTION_KEY is missing)
AIGP_ENCRYPTION_SEED=aigp-dev-default

# Optional Redis REST backend for redteam abort flags (multi-replica)
# AIGP_ABORT_REDIS_REST_URL=
# AIGP_ABORT_REDIS_REST_TOKEN=
# AIGP_ABORT_REDIS_TTL_SECONDS=3600

# --- Background job queue (BullMQ) ---
# When set, drift runs + the incident pipeline run on the worker container, and
# public endpoint rate-limit buckets are shared across web replicas.
# When unset, they run inline in-process (dev/CI default).
REDIS_URL=redis://localhost:6379
# Worker concurrency (default 2).
AIGP_WORKER_CONCURRENCY=2

# Evidence/report storage. Default is local disk; use S3 for multi-replica web.
# AIGP_STORAGE_DRIVER=local
# AIGP_STORAGE_ROOT=./storage/evidence
# AIGP_STORAGE_DRIVER=s3
# AIGP_S3_BUCKET=aigp-evidence
# AIGP_S3_REGION=us-east-1
# AIGP_S3_ENDPOINT=                         # MinIO/other S3-compatible endpoint
# AIGP_S3_FORCE_PATH_STYLE=false
# AIGP_S3_PREFIX=evidence
# AIGP_S3_ACCESS_KEY_ID=
# AIGP_S3_SECRET_ACCESS_KEY=

# NextAuth
NEXTAUTH_SECRET=replace-me-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# SSO / OIDC (optional — Credentials login always stays enabled).
# SSO turns on only when all four required vars are set AND the target org exists
# (validated at startup by src/instrumentation.ts; disabled with a log line otherwise).
# New SSO users are JIT-provisioned into SSO_OIDC_ORG_ID with the `viewer` role.
# SSO_OIDC_ISSUER=https://idp.example.com         # OIDC issuer URL (discovery base)
# SSO_OIDC_CLIENT_ID=
# SSO_OIDC_CLIENT_SECRET=
# SSO_OIDC_ORG_ID=                                 # existing Organization id to map SSO users into
# Optional:
# SSO_OIDC_BUTTON_LABEL=Sign in with SSO           # login-page button text (default: "Sign in with SSO")
# SSO_OIDC_ALLOWED_DOMAINS=example.com,corp.example.com   # comma-separated email-domain allowlist (unset = any verified email)

# Sentry (optional — errors silently ignored when unset)
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug

# --- Moonshot integration ---
# Red-team library: include the statically-imported Moonshot attack set.
# Default: ON when AIGP_MOONSHOT_URL is unset, OFF when the engine is wired.
# Set to "true" to force on (offline fallback) or "false" to force off.
# AIGP_REDTEAM_MOONSHOT_STATIC=true

# Moonshot evaluation engine (Phase A). Unset = engine disabled (built-in runner used).
# AIGP_MOONSHOT_URL=http://moonshot:5000
# AIGP_MOONSHOT_API_KEY=

# --- Egress guard (SSRF protection) ---
# Outbound destinations configured by org admins (audit sinks, webhook
# endpoints, Slack/Teams/ServiceNow integrations, LLM provider base URLs)
# are blocked when they point at private/internal ranges (loopback, RFC1918,
# link-local/cloud-metadata, CGNAT, ULA) — checked at save time and before
# every delivery. To permit legitimate internal destinations, list them
# here, comma-separated: CIDRs, exact IPs, exact hostnames, or wildcard
# hostnames (*.corp.local matches subdomains only, not the apex).
# AIGP_EGRESS_ALLOWLIST=10.0.0.0/8,splunk.internal,*.corp.local
# Local dev pointing sinks/providers at localhost:
# AIGP_EGRESS_ALLOWLIST=127.0.0.1/32,localhost

# Seed the "Demo Org" + *@demo.local / demo1234 accounts. Defaults to on unless
# NODE_ENV=production. Set to 0 for any internet-facing deployment.
# AIGP_SEED_DEMO=1
