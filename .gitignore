# macOS
.DS_Store

# Editor
.vscode/
.idea/

# Node (for upcoming Next.js app)
node_modules/
tsconfig.tsbuildinfo
.next/
out/
build/
dist/
*.log

# Package manager: this project uses npm (package-lock.json). Ignore stray
# pnpm/yarn lockfiles from local installs so they don't become a second source of truth.
pnpm-lock.yaml
yarn.lock
# Ignore every .env variant except the committed template (.env.bak with real
# dev secrets was once committed because the old patterns missed it).
.env*
!.env.example

# Testing
coverage/
playwright-report/
test-results/
tests/e2e/.auth/
.playwright-mcp/

# Local storage (evidence uploads)
storage/
.figma-source
prisma/dev.db

# Prisma 7 generated client (regenerated by `npm run prisma:generate`)
src/generated/

# CycloneDX SBOM — generated build output, produced fresh per CI run
sbom.json

# Next.js 16 agent-rules files — `next dev` writes (and re-adds) these on every
# run, so tracking them just means a permanently dirty tree. Regenerated
# locally for anyone who runs the dev server; see
# node_modules/next/dist/server/lib/generate-agent-files.js
/AGENTS.md
/CLAUDE.md

# Third-party licensed reports (no redistribution rights) and personal notes — keep local only
/*_ndx.pdf
/*_ndx.txt
/portfolio/
