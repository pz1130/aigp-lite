  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint src --ext .ts,.tsx && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "e2e": "playwright test",
    "prisma:generate": "node prisma/build-schema.mjs && prisma generate",
    "prisma:migrate": "node prisma/build-schema.mjs && prisma migrate dev",
    "prisma:deploy": "node prisma/build-schema.mjs && prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "node prisma/build-schema.mjs && prisma studio",
    "openapi:export": "tsx scripts/openapi-export.ts",
    "test:db:setup": "bash scripts/setup-test-db.sh",
    "audit:backfill": "tsx scripts/audit/backfill-chain.ts",
    "crypto:rotate-key": "tsx scripts/crypto/rotate-encryption-key.ts",
    "finos:import": "tsx scripts/finos/import.ts",
    "atlas:backfill": "tsx scripts/atlas/backfill-refs.ts",
    "imda:import": "tsx prisma/seeds/imda-importer.ts",
    "aivtf:import": "tsx prisma/seeds/aivtf-importer.ts",
    "nist:import": "tsx prisma/seeds/nist-importer.ts",
    "iso42001:import": "tsx prisma/seeds/iso42001-importer.ts",
    "euaiact:import": "tsx prisma/seeds/eu-ai-act-importer.ts",
    "mindforge:import": "tsx prisma/seeds/mindforge-importer.ts",
    "mindforge:crosswalk": "tsx prisma/seeds/mindforge-crosswalk-importer.ts",
    "mindforge-checklist:import": "tsx prisma/seeds/mf-checklist-importer.ts",
    "asi:import": "tsx prisma/seeds/owasp-asi-importer.ts",
    "agentic-governance:import": "tsx prisma/seeds/agentic-governance-importer.ts",
    "frameworks:status": "tsx scripts/frameworks-status.ts",
    "sbom:generate": "cyclonedx-npm --omit dev --output-file sbom.json --ignore-npm-errors",
    "worker": "tsx src/worker/index.ts",
    "worker:smoke": "vitest run --configLoader runner src/worker/smoke.test.ts"
  },
